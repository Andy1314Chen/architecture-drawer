# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Maintainer-only guidelines (not user-facing).
AGENTS.md

# LLM replay outputs (non-deterministic, not version-controlled).
# See: pytest --llm-replay
replay_out/

# Generated diagram artifacts (regenerable). The gen.py scripts co-located in
# evals/<name>/ and examples/<name>/ stay version-controlled; only their
# SVG/PNG/PPTX outputs are ignored.
#
# PPTX: global — no tracked .pptx exists anywhere (golden snapshots are .svg).
*.pptx
# SVG/PNG: path-scoped so tests/golden/*.svg baselines stay tracked.
plugins/**/*.svg
plugins/**/*.png
examples/**/*.svg
examples/**/*.png

# Scratch output for ad-hoc diagram runs (not an evals/ case, so not under
# test). Move a diagram into evals/<name>/ with a gen.py to make it tracked.
output/
